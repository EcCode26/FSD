<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
</head>
<body>
    <h2>User Authentication</h2>
    <form action="/login" method="POST">
        Username :
        <input type="text" name="username">
        <br><br>
        Password :
        <input type="password" name="password">
        <br><br>
        <button type="submit">
            Login
        </button>
    </form>
    <br>
    <h3 style="color:red;">
        <%= error %>
    </h3>
</body>
</html>