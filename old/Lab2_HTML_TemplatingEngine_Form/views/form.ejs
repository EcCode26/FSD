<!DOCTYPE html>

<html>

<head>

    <title>Student Registration</title>

</head>

<body>

<h1>Student Registration Form</h1>

<hr>

<form action="/register" method="POST">

    <label>Student Name</label>

    <br>

    <input type="text"
           name="name"
           required>

    <br><br>

    <label>Age</label>

    <br>

    <input type="number"
           name="age"
           required>

    <br><br>

    <label>Branch</label>

    <br>

    <input type="text"
           name="branch"
           required>

    <br><br>

    <label>Semester</label>

    <br>

    <input type="text"
           name="semester"
           required>

    <br><br>

    <label>Email</label>

    <br>

    <input type="email"
           name="email"
           required>

    <br><br>

    <label>Mobile Number</label>

    <br>

    <input type="text"
           name="mobile"
           required>

    <br><br>

    <button type="submit">

        Register

    </button>

</form>

<br>

<a href="/">Home</a>

</body>

</html>